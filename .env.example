OPENAI_API_KEY=
OPENAI_QUIZ_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: full path to an existing FFmpeg installation.
FFMPEG_PATH=
LECTURE_LAB_DATA_DIR=data

# Optional reranking; generation falls back to vector search if unavailable.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast

# Google OAuth web client. Register the callback at http://127.0.0.1:8765/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
